<!DOCTYPE html>
        <html lang="es">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>ECCOLAB · Validación Profesional</title>
            <style>
                * { margin: 0; padding: 0; box-sizing: border-box; }
                body {
                    font-family: 'Inter', -apple-system, sans-serif;
                    background: #001F3F;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    min-height: 100vh;
                    padding: 20px;
                }
                .validation-card {
                    background: white;
                    max-width: 600px;
                    width: 100%;
                    padding: 40px;
                    border: 6px solid #FF5722;
                    box-shadow: 20px 20px 0 rgba(255, 87, 34, 0.3);
                    text-align: center;
                }
                .validation-card h1 {
                    font-family: 'Playfair Display', serif;
                    color: #001F3F;
                    font-size: 2rem;
                    margin-bottom: 8px;
                }
                .validation-card .subtitle {
                    color: #FF5722;
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 3px;
                    font-size: 0.8rem;
                    margin-bottom: 24px;
                }
                .validation-card .badge {
                    background: #001F3F;
                    color: white;
                    padding: 8px 24px;
                    display: inline-block;
                    font-weight: 700;
                    font-size: 0.9rem;
                    margin-bottom: 24px;
                    border-left: 4px solid #FF5722;
                }
                .validation-card img {
                    max-width: 100%;
                    height: auto;
                    border: 4px solid #001F3F;
                    box-shadow: 8px 8px 0 rgba(0, 31, 63, 0.15);
                }
                .validation-card .footer {
                    margin-top: 24px;
                    font-size: 0.7rem;
                    color: #6b7280;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                    border-top: 2px solid #e5e7eb;
                    padding-top: 16px;
                }
                .validation-card .footer strong {
                    color: #001F3F;
                }
            </style>
        </head>
        <body>
            <div class="validation-card">
                <h1>ECCOLAB</h1>
                <div class="subtitle">Validación de Profesional</div>
                <div class="badge">✓ CREDENCIAL VÁLIDA</div>
                <img src="data:image/png;base64," alt="Validación ECCOLAB">
                <div class="footer">
                    <strong>ECCOLAB</strong> · Identidad Médica · 2026
                </div>
            </div>
        </body>
        </html>
